  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Been a week since I landed in this prison. Out of all the filth I could\u2019ve
    crossed paths with, I ran into Martin. To him, I\u2019m the one face he maybe
    hates more than his own father. He knows this place inside out. He could\u2019ve
    put me down himself, easy. But nah\u2026 he went for something worse.\r\n\r\nHe
    ran his mouth. Said I was getting too close to some guys. And in here, that kind
    of talk is poison. Nobody wants to be called a fag in Tocor\xF3n. One rumor\u2019s
    enough to get you tossed to the roof with the rest of the dead men walking. That\u2019s
    how I ended up here.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
